# Hevy API key: Hevy app > Settings > Developer (requires Hevy Pro)
HEVY_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional. Postgres connection (default: local Supabase on port 58322,
# postgresql://postgres:postgres@127.0.0.1:58322/postgres)
DATABASE_URL=
# Folder that holds the Obsidian training logs, read-only
# (default: examples/obsidian, the fictional demo logs)
OBSIDIAN_LOGS_DIR=
# First day of comparable history used by report.py and load_steps.py
# (default: 2026-01-05, fictional)
TRAINING_HISTORY_START=

# Optional ping URLs for the scheduled job (any Healthchecks-compatible service)
HEALTHCHECK_URL_SYNC=
HEALTHCHECK_URL_RELATORIO=
